# Copiá este archivo a .env y completá los valores.
# Generá secretos fuertes con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=puertaApuerta_db
DB_USER=dev_user
DB_PASSWORD=cambiar_este_valor

# Obligatorio. Mínimo 32 caracteres. No usar valores por defecto.
JWT_SECRET=generar_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Whitelist CORS separada por comas. En producción es obligatoria.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Secreto de firma del webhook de Mercado Pago.
# Si falta, /api/v1/pagos/webhook responde 503 y no procesa pagos.
MERCADOPAGO_WEBHOOK_SECRET=generar_un_secreto_para_webhooks

# Firebase (opcional, para notificaciones push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
